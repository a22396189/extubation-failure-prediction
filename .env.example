# Copy this file to .env and fill in the values for your machine, or set
# these as real environment variables (System Environment Variables on
# Windows, or `export VAR=value` / `$env:VAR="value"` in your shell).
# .env itself is gitignored and must never be committed.

# Root of this project (the folder that contains data/, results/, etc.)
# used by scripts to locate this project's own inputs/outputs.
EXTUBATION_PROJECT_ROOT=C:\path\to\extubation_failure_prediction

# Root of your local MIMIC-IV raw-data / DuckDB project
# (contains mimic.duckdb and the MIMIC-IV CSV/Parquet source files),
# used by the to duckdb/, static feature extraction/, and
# time series feature extraction/ scripts.
MIMIC_DATA_DIR=C:\path\to\your\mimic-iv-project
